# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
VOYAGE_API_KEY=

# Answer generation. OpenAI is the default; set LLM_PROVIDER=anthropic to use
# the Claude fallback instead (then ANTHROPIC_API_KEY is required too).
OPENAI_API_KEY=
LLM_PROVIDER=openai

# Shared secret for the remote MCP endpoint at /mcp. Unset = no auth (local only).
MCP_TOKEN=

# OAuth 2.1 for connector directories. Setting OAUTH_PASSWORD enables the
# authorization-code flow and disables the static MCP_TOKEN above.
OAUTH_PASSWORD=
PUBLIC_URL=https://your-host.example
ANSWER_MODEL=gpt-6.1-terra

# Optional: ANTHROPIC_API_KEY=... and ANTHROPIC_ANSWER_MODEL=claude-sonnet-5
