# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
VOYAGE_API_KEY=

# Answer generation. OpenAI is the default; set LLM_PROVIDER=anthropic to use
# the Claude fallback instead (then ANTHROPIC_API_KEY is required too).
OPENAI_API_KEY=
LLM_PROVIDER=openai

# Shared secret for the remote MCP endpoint at /mcp. Unset = no auth (local only).
MCP_TOKEN=
ANSWER_MODEL=gpt-6.1-terra

# Optional: ANTHROPIC_API_KEY=... and ANTHROPIC_ANSWER_MODEL=claude-sonnet-5
